{
  "name": "qtfoods/erp-crm-backend",
  "type": "project",
  "description": "Q & T FOODS LTD Manufacturing ERP + CRM backend",
  "license": "proprietary",
  "require": {
    "ext-bcmath": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-redis": "*",
    "php": "^8.5",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "ext-pdo_sqlite": "*",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ],
    "test": "vendor/bin/phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
