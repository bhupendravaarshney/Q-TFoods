APP_NAME="Q & T FOODS ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Kolkata

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qtfoods
DB_USERNAME=qtfoods
DB_PASSWORD=qtfoods

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local

QT_REQUIRE_IDEMPOTENCY=true
QT_REQUIRE_MAKER_CHECKER=true
QT_SIMULATION_ISOLATED=true
QT_EVIDENCE_DISK=evidence
QT_EVIDENCE_RETENTION_YEARS=7
QT_EVIDENCE_RETENTION_POLICY=UNSOLD_RETURN_7Y
QT_EVIDENCE_MAX_UPLOAD_KB=10240
