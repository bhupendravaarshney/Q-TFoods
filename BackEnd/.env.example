APP_NAME="Q & T FOODS ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Asia/Kolkata

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=qtfoods
DB_USERNAME=qtfoods
DB_PASSWORD=qtfoods

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=qtfoods
AWS_SECRET_ACCESS_KEY=qtfoods-secret-change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=qtfoods-evidence
FINANCE_ARCHIVE_BUCKET=qtfoods-evidence
AWS_ENDPOINT=http://127.0.0.1:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@qtfoods.local
MAIL_FROM_NAME="Q & T Foods ERP"

QT_REQUIRE_IDEMPOTENCY=true
QT_REQUIRE_MAKER_CHECKER=true
QT_SIMULATION_ISOLATED=true
QT_EVIDENCE_DISK=evidence
QT_EVIDENCE_RETENTION_YEARS=7
QT_EVIDENCE_RETENTION_POLICY=UNSOLD_RETURN_7Y
QT_EVIDENCE_MAX_UPLOAD_KB=10240
QT_EVIDENCE_LEGACY_ROOT=storage/app/private/evidence-legacy
QT_APPROVAL_WORK_ITEM_DUE_HOURS=24
QT_OUTBOX_TRANSPORT=log
QT_OUTBOX_HTTP_ENDPOINT=
QT_OUTBOX_SIGNING_SECRET=
QT_OUTBOX_TIMEOUT_SECONDS=10
QT_OUTBOX_REQUIRE_ACKNOWLEDGEMENT=true
QT_OUTBOX_ACKNOWLEDGEMENT_HEADER=X-Acknowledgement-ID
QT_OUTBOX_BATCH_SIZE=50
QT_OUTBOX_MAX_ATTEMPTS=8
QT_OUTBOX_BASE_RETRY_SECONDS=30
QT_OUTBOX_MAX_RETRY_SECONDS=3600
QT_OUTBOX_LOCK_TIMEOUT_SECONDS=300
QT_FRONTEND_URL=http://localhost:5173
QT_IDENTITY_PREVIEW_LINKS=true
QT_INVITATION_HOURS=72
QT_PASSWORD_RESET_MINUTES=60
QT_EMAIL_VERIFICATION_MINUTES=60
QT_MFA_SETUP_MINUTES=10
QT_MFA_CHALLENGE_MINUTES=5
